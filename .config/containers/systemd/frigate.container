# Podman Quadlet container for frigate
# Generated by scaffold-homelab-batch.py

[Unit]
Description=frigate container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=frigate
Image=ghcr.io/blakeblackshear/frigate:stable
Network=host
Userns=keep-id

EnvironmentFile=homelab/frigate/frigate.env
Environment=TZ=Europe/Brussels

WorkingDirectory=~
Volume=homelab/frigate/config:/config:z
Volume=homelab/frigate/media:/media:Z
Volume=homelab/frigate/recordings:/recordings:Z
Device=/dev/bus/usb:/dev/bus/usb
Device=/dev/dri:/dev/dri

AutoUpdate=registry

Restart=always

[Install]
WantedBy=default.target
