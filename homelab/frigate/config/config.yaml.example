# yaml-language-server: $schema=http://frigate_host:5000/api/config/schema.json
# Example Frigate configuration (minimal)
# Replace placeholders and extend with camera definitions
mqtt:
  host: "{FRIGATE_MQTT_HOST}"
  port: 1883
  user: "{FRIGATE_MQTT_USER}"
  password: "{FRIGATE_MQTT_PASSWORD}"

# Enable Coral Edge TPU via USB
detectors:
  coral:
    type: edgetpu
    # For USB use: device: usb
    device: usb

$ Optional VAAPI hardware acceleration for decoding video
ffmpeg:
  hwaccel_args: preset-vaapi

detect:
  width: 1920
  height: 1080
  fps: 5

objects:
  track:
    - person
    - car

review:
  alerts:
    enabled: True
    labels:
      - car
      - person

record:
  enabled: True
  motion:
    days: 7
  alerts:
    retain:
      days: 30
      mode: motion
  detections:
    retain:
      days: 30
      mode: motion

# See https://docs.frigate.video/configuration/genai/genai_config
# genai:
#   provider: gemini
#   api_key: "{FRIGATE_GEMINI_API_KEY}"
#   model: gemini-2.5-flash

cameras:
  # Example camera block
  # See also https://docs.frigate.video/configuration/camera_specific
  front_door:
    ffmpeg:
      inputs:
        - path: rtsp://{FRIGATE_RTSP_USER}:{FRIGATE_RTSP_PASSWORD}@10.0.10.10:554/rtsp
          roles:
            - detect
        - path: rtsp://{FRIGATE_RTSP_USER}:{FRIGATE_RTSP_PASSWORD}@10.0.10.10:554/rtsp
          roles:
            - record
    fps: 5
    detect:
      enabled: true
      max_disappeared: 25
    motion:
      # Mask off timestamp
      mask:
        - 0.000,0.427,0.002,0.000,0.999,0.000,0.999,0.781,0.885,0.456,0.700,0.424,0.701,0.311,0.507,0.294,0.453,0.347,0.451,0.400
    objects:
      # Optional: list of objects to track from labelmap.txt (default: shown below)
      track:
        - person


snapshots:
  enabled: True
  retain:
    default: 5
    objects:
      person: 10

# Paths: Frigate will use /config, /media inside container
